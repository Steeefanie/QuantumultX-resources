  "all_services": true,
  "all_collections": true,
  "collections": {
    "domestic": {
      "title": "国内接入域名合集（不等于全部国内网站或中国IP）",
      "include": [
        "geolocation-cn"
      ],
      "policy": "direct"
    },
    "global": {
      "title": "上游归类为无中国大陆接入点的域名合集（非全部海外网站）",
      "include": [
        "geolocation-!cn"
      ],
      "policy": "proxy"
    },
    "advertising": {
      "title": "明确广告及跟踪域名（可选，可能影响统计或应用功能）",
      "include": [
        "category-ads"
      ],
      "policy": "reject",
      "include_ads": true
    },
    "ai-global": {
      "title": "境外AI与模型服务",
      "include": [
        "category-ai-!cn"
      ],
      "policy": "proxy"
    },
    "ai-domestic": {
      "title": "境内接入AI与模型服务",
      "include": [
        "category-ai-cn"
      ],
      "policy": "direct"
    },
    "media": {
      "title": "媒体服务（含不同地区，按业务需要覆盖策略）",
      "include": [
        "category-media"
      ],
      "policy": "proxy"
    },
    "development": {
      "title": "开发与软件服务（不保证均需代理）",
      "include": [
        "category-dev"
      ],
      "policy": "proxy"
    },
    "games": {
      "title": "游戏服务（含不同地区，下载与登录需求可能不同）",
      "include": [
        "category-games"
      ],
      "policy": "proxy"
    },
    "social-global": {
      "title": "境外社交媒体",
      "include": [
        "category-social-media-!cn"
      ],
      "policy": "proxy"
    },
    "scholar-global": {
      "title": "境外学术服务（不代替机构访问授权）",
      "include": [
        "category-scholar-!cn"
      ],
      "policy": "proxy"
    },
    "cloud-global": {
      "title": "境外网盘服务（网页与同步可能需要不同策略）",
      "include": [
        "category-netdisk-!cn"
      ],
      "policy": "proxy"
    },
    "lan": {
      "title": "上游私有网络与路由器域名的可转换部分（不包含私网IP及单标签后缀）",
      "include": [
        "private"
      ],
      "policy": "direct"
    },
    "google-without-youtube": {
      "title": "Google 综合域名（排除 YouTube 分类的专用条件；共享域名仍可能交叉）",
      "include": [
        "google"
      ],
      "exclude": [
        "youtube"
      ],
      "policy": "proxy"
    }
  },
