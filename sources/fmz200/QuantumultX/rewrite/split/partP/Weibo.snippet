^https?:\/\/m?api\.weibo\.c(n|om)\/2\/(statuses\/(unread|friends|hot)_timeline|cardlist|searchall) url script-response-body https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/weibo.js
