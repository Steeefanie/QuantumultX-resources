#!name=Safari 超级搜索 Q-Search
#!desc=将 Safari 默认搜索引擎设为 DuckDuckGo 后，在地址栏输入 gh/yt/zh/bili/xh/bd + 空格 + 关键词即可直达对应网站搜索，无前缀默认转 Google
#!author=ddgksf2013
#!homepage=https://github.com/Steeefanie/QuantumultX-resources

# GitHub: gh 关键词
^https:\/\/duckduckgo\.com\/\?q=gh\+([^&]+).+ url 302 https://github.com/search?q=$1
# YouTube: yt 关键词
^https:\/\/duckduckgo\.com\/\?q=yt\+([^&]+).+ url 302 https://www.youtube.com/results?search_query=$1
# 知乎: zh 关键词
^https:\/\/duckduckgo\.com\/\?q=zh\+([^&]+).+ url 302 https://www.zhihu.com/search?type=content&q=$1
# 哔哩哔哩: bili 关键词
^https:\/\/duckduckgo\.com\/\?q=bili\+([^&]+).+ url 302 https://m.bilibili.com/search?keyword=$1
# 小红书: xh 关键词
^https:\/\/duckduckgo\.com\/\?q=xh\+([^&]+).+ url 302 https://www.xiaohongshu.com/search_result?keyword=$1
# 豆瓣: db 关键词
^https:\/\/duckduckgo\.com\/\?q=db\+([^&]+).+ url 302 https://m.douban.com/search/?query=$1
# 维基百科: wk 关键词
^https:\/\/duckduckgo\.com\/\?q=wk\+([^&]+).+ url 302 https://zh.wikipedia.org/wiki/$1
# 百度: bd 关键词
^https:\/\/duckduckgo\.com\/\?q=bd\+([^&]+).+ url 302 https://www.baidu.com/s?wd=$1
# 默认无前缀：直接转 Google 搜索
^https:\/\/duckduckgo\.com\/\?q=([^&]+).+ url 302 https://www.google.com/search?q=$1

hostname = duckduckgo.com
