# > 网易云解锁VIP（请求头注入试听权限，不改变黑胶外观，外观与净化见 netease-cloud-music.conf）
^https?:\/\/.+music.+(player\/url|playlist|entrance|\/eapi\/search\/).*$ url script-request-header https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/Wyy.js

hostname = *.music.163.com
