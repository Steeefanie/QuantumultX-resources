#!name=微信公众号
#!desc=某些APP要清除缓存或者重新安装拦截广告才会生效！
#!author=奶思
#!homepage=https://github.com/fmz200/wool_scripts
#!icon=https://raw.githubusercontent.com/fmz200/wool_scripts/main/icons/gif/naisi-01.gif
#!raw-url=https://github.com/fmz200/wool_scripts/raw/main/QuantumultX/rewrite/split/partW/WeChatOfficialAccount.snippet
#!tg-group=https://t.me/QuantumultXCommunity
#!date=undefined
#############################################


host-suffix, wxs.qq.com, reject
host-suffix, as.weixin.qq.com, reject

# 公众号文章底部与文中嵌入式广告
^https?:\/\/mp\.weixin\.qq\.com\/mp\/getappmsgad url script-response-body https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/wechat.js
# 微信公众号文章底部商品推广卡片
^https?:\/\/mp\.weixin\.qq\.com\/mp\/cps_product_info url reject-dict
# 微信公众号文章内关联搜索词广告
^https?:\/\/mp\.weixin\.qq\.com\/mp\/relatedsearchword url reject-dict
# 微信朋友圈与公众号动态视频推广流
^https?:\/\/wxsnsdy\.wxs\.qq\.com url reject-200
^https?:\/\/wxsnsdythumb\.wxs\.qq\.com url reject-200

hostname = mp.weixin.qq.com, wxsnsdy.wxs.qq.com, wxsnsdythumb.wxs.qq.com
