^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$) url script-response-body https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/revenuecat.js
^https?:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$) url script-request-header https://raw.githubusercontent.com/fmz200/wool_scripts/main/Scripts/revenuecat.js

hostname = api.revenuecat.com, api.rc-backup.com
