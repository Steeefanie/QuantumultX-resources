  "modules": [
    {
      "id": "spotify",
      "category": "vip",
      "source": "module/spotify.conf",
      "title": "Spotify VIP 解锁与净化",
      "scripts": [
        "js/spotify-qx-header.js",
        "js/spotify-proto.js",
        "js/spotify-json.js"
      ],
      "enabled": false,
      "needs_mitm": true,
      "notes": "上游限定 iOS 15 及以上；涉及广告与播放行为，不能提供超高音质；不保证付费权益或长期有效。",
      "filters": [],
      "description": "移除匹配请求中的 If-None-Match 缓存校验头，让对应接口重新返回响应内容。 / 解码并重编码匹配的协议响应，调整广告、播放行为及部分客户端账户属性字段。 / 将匹配请求中的 platform=iphone 改为 platform=ipad，并处理主机名后的 :443 写法。"
    },
    {
